# Top-level Spectrum credentials (from your Photon dashboard).
PROJECT_ID=
PROJECT_SECRET=

# Convex HTTP/client URLs from `.env.local` after `npx convex dev`.
CONVEX_URL=https://precise-toad-279.convex.cloud
CONVEX_SITE_URL=https://precise-toad-279.convex.site

# Gemini through the Vercel AI SDK Google provider.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Spotify OAuth. Redirect URI:
# https://<your-convex-deployment>.convex.site/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_TOKEN_ENCRYPTION_KEY=

# Stripe payment link and webhook settings.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_LINK=https://buy.stripe.com/test_3cI9ATgACa1o5cW0g39IQ00
